# Copy this file to .env and fill in the values. .env is git-ignored; never commit it.
#   cp .env.example .env

# --- FalkorDB Cloud (free tier, 100 MB) ---
# Create an instance:  https://app.falkordb.cloud
# Then copy the connection string from the instance page. Format:
#   falkor://default:<password>@<host>:<port>      (use falkors:// if the instance requires TLS)
# Docs: https://docs.falkordb.com/cloud
FALKORDB_URL=

# --- OpenRouter (agent LLM) ---
# Create a key:   https://openrouter.ai/keys
# Pick a model:   https://openrouter.ai/models   (needs tool-calling / structured output)
# Add credit:     https://openrouter.ai/credits
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Optional ---
# Only set if Playwright cannot find Chromium on its own.
# CHROMIUM_PATH=/path/to/chrome

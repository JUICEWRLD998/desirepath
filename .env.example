# Copy this file to .env and fill in the values. .env is git-ignored; never commit it.
#   cp .env.example .env

# --- FalkorDB Cloud (free tier, 100 MB) ---
# Create an instance:  https://app.falkordb.cloud
# Docs: https://docs.falkordb.com/cloud
# Option 1: one connection URL    falkor://<username>:<password>@<host>:<port>   (falkors:// if TLS)
#   Special characters in the password must be URL-encoded (@ -> %40, # -> %23, / -> %2F).
FALKORDB_URL=
# Option 2 (use if option 1 gives WRONGPASS): separate fields, no encoding needed. Leave FALKORDB_URL empty.
FALKORDB_HOST=
FALKORDB_PORT=
FALKORDB_USERNAME=default
FALKORDB_PASSWORD=
FALKORDB_TLS=false

# --- OpenRouter (agent LLM) ---
# Create a key:   https://openrouter.ai/keys
# Add credit:     https://openrouter.ai/credits
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Optional ---
# Only set if Playwright cannot find Chromium on its own.
# CHROMIUM_PATH=/path/to/chrome
